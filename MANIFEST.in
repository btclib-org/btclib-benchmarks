# the sdist is not how this project is used -- the scripts are run from a
# checkout -- but it is what check-manifest, pyroma and twine inspect, and
# a distribution that omits the thing it is named after would pass none of
# them. So the benchmarks and their tests ship, and the repository
# furniture that means nothing outside a checkout does not
include *.md
include COPYRIGHT LICENSE
include pyproject.toml uv.lock
include .python-version
recursive-include scripts *.py
recursive-include tests *.py
# the vendored vectors and the file that says where they came from, which
# the benchmarks and the suite both read and check the digests of.
# WYCHEPROOF_COPYING has no extension and is named in full: it is the
# licence of one of the three, and a licence ships with what it covers
recursive-include vectors *.csv *.json *.md
include vectors/WYCHEPROOF_COPYING
# the runs the README links to, which are output rather than furniture:
# a checkout is where a benchmark is run, and these say what running one
# produced on a machine that is named. The .json beside each page is that
# run as data and the page is rendered from it, so shipping one without
# the other would ship a page nothing can rebuild; machine.toml is the two
# lines of it no process can answer
recursive-include results *.md *.json *.toml
# the documentation sources, which the sphinx gate builds from an
# unpacked sdist as readily as from a checkout
recursive-include docs *.md
recursive-include docs *.py
exclude .pre-commit-config.yaml .secrets.baseline
exclude .gitattributes .markdownlint.jsonc .taplo.toml .yamllint.yaml
exclude .readthedocs.yaml
prune .github
prune .vscode
